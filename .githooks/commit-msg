#!/bin/sh
# Mensagem no padrão Conventional Commits (CONTRIBUTING). Merges e reverts passam.
primeira_linha=$(head -n 1 "$1")

case "$primeira_linha" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s' "$primeira_linha" | grep -Eq '^(feat|fix|test|chore|docs|refactor|release|hotfix)(\([a-z0-9._-]+\))?: .+'; then
  echo "Mensagem fora do padrão: \"$primeira_linha\""
  echo "Use tipo: descrição (feat, fix, test, chore, docs, refactor, release ou hotfix)."
  exit 1
fi
