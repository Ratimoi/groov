{
  "expo": {
    "name": "Groov",
    "slug": "groov",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "groov",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ratimoi.groov",
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131313",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O Groov usa a câmera para ler o QR code dos ingressos na portaria.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Groov usa a sua localização para mostrar eventos perto de você."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Groov acessa suas fotos para você escolher as imagens do evento e o seu avatar.",
          "cameraPermission": "O Groov usa a câmera para você tirar a foto do evento ou do seu avatar."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "605f4e04-2bd0-4bda-8a1d-b3b0e93756f0"
      }
    },
    "owner": "ratimoi",
    "updates": {
      "url": "https://u.expo.dev/605f4e04-2bd0-4bda-8a1d-b3b0e93756f0"
    }
  }
}
