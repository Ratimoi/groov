PORT=3333
NODE_ENV=development
DATABASE_URL=
# Segredo de assinatura dos tokens (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do token (padrão 1d). Exemplos: 15m, 12h, 7d
JWT_EXPIRES_IN=1d

# Pagamentos (Mercado Pago). Sem o token o pagamento é simulado (aprova na hora, sem cobrar).
# Use a credencial de TESTE (TEST-...) até validar tudo; troque pela de produção só no final.
MERCADOPAGO_ACCESS_TOKEN=
# URL pública da API: o Mercado Pago avisa por ela (webhook) e o checkout do cartão volta para ela.
PUBLIC_API_URL=
