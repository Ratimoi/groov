generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id String @id @default(cuid())

  nome      String
  username  String  @unique
  avatarUrl String?

  email    String   @unique
  senha    String
  // Só dígitos. Nulo em contas anteriores à exigência do CPF; nunca sai nas respostas da API.
  cpf      String?  @unique
  papel    Papel    @default(CLIENTE)
  criadoEm DateTime @default(now())

  pedidos             Pedido[]
  ingressos           Ingresso[]           @relation("DonoIngresso")
  validacoes          ValidacaoIngresso[]  @relation("ValidadoPor")
  eventosCriados      Evento[]             @relation("CriadorEvento")
  gruposLiderados     Grupo[]              @relation("LiderGrupo")
  participacoes       MembroGrupo[]
  comprasIniciadas    CompraGrupo[]        @relation("IniciadorCompra")
  participacoesCompra ParticipanteCompra[]
  atracoesVinculadas  Atracao[]
  avaliacoes          AvaliacaoEvento[]
  cargosEvento        EventoMembro[]
  pedidosIndicados    Pedido[]             @relation("PromotorPedido")
  pagamentos          Pagamento[]
  curtidas            CurtidaEvento[]
  eventosSalvos       EventoSalvo[]
  seguindo            Seguidor[]           @relation("QuemSegue")
  seguidores          Seguidor[]           @relation("QuemEhSeguido")
}

model Categoria {
  id      String   @id @default(cuid())
  nome    String   @unique
  eventos Evento[]
}

model Evento {
  id        String    @id @default(cuid())
  titulo    String
  descricao String?
  imagemUrl String?
  comecaEm  DateTime
  terminaEm DateTime?
  horario   DateTime? @db.Time
  nomeLocal String?
  cidade    String
  destaque  Boolean?  @default(false)
  // Selos de classificação do evento (ex.: "18+", "open bar"), definidos por quem cria o evento.
  tags      String[]  @default([])
  atracoes  Atracao[]
  // Endereço e ponto no mapa (usados na busca "perto de mim").
  endereco  String?
  latitude  Float?
  longitude Float?

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  // Quem publicou é o gerente do evento: edita, apaga e monta a equipe (promotores e validadores).
  criadoPorId String?
  criadoPor   Usuario? @relation("CriadorEvento", fields: [criadoPorId], references: [id])

  // Moderação: um evento oculto pelo ADMIN some das listagens e das buscas.
  ocultoEm     DateTime?
  ocultoMotivo String?

  // Programa de promotores: quem compra com o código de um promotor ganha `descontoAfiliado` (fração,
  // 0.1 = 10%) e o promotor recebe `comissaoPromotor` do valor dos ingressos. Nulo = sem programa.
  descontoAfiliado Decimal? @db.Decimal(5, 4)
  comissaoPromotor Decimal? @db.Decimal(5, 4)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  lotes      Lote[]
  pedidos    Pedido[]
  ingressos  Ingresso[]
  validacoes ValidacaoIngresso[]
  avaliacoes AvaliacaoEvento[]
  equipe     EventoMembro[]
  curtidas   CurtidaEvento[]
  salvos     EventoSalvo[]

  @@index([cidade])
}

model Lote {
  id                String   @id @default(cuid())
  eventoId          String
  evento            Evento   @relation(fields: [eventoId], references: [id])
  nome              String
  preco             Decimal  @db.Decimal(10, 2)
  quantidade        Int
  quantidadeVendida Int      @default(0)
  criadoEm          DateTime @default(now())

  tamanhoGrupo        Int?
  descontoGrupo       Decimal? @db.Decimal(5, 4)
  prazoGrupoHoras     Int?
  quantidadeReservada Int      @default(0)

  pedidos      Pedido[]
  ingressos    Ingresso[]
  comprasGrupo CompraGrupo[]

  @@index([eventoId])
}

model Pedido {
  id         String       @id @default(cuid())
  usuarioId  String
  usuario    Usuario      @relation(fields: [usuarioId], references: [id])
  eventoId   String
  evento     Evento       @relation(fields: [eventoId], references: [id])
  loteId     String
  lote       Lote         @relation(fields: [loteId], references: [id])
  quantidade Int          @default(1)
  status     StatusPedido @default(PENDENTE)

  subtotal    Decimal @db.Decimal(10, 2)
  desconto    Decimal @default(0) @db.Decimal(10, 2)
  taxaServico Decimal @default(0) @db.Decimal(10, 2)
  valor       Decimal @db.Decimal(10, 2)

  criadoEm DateTime  @default(now())
  pagoEm   DateTime?

  // Venda por link de promotor: quem indicou, o código usado e a comissão devida (só registrada).
  promotorId     String?
  promotor       Usuario? @relation("PromotorPedido", fields: [promotorId], references: [id])
  codigoAfiliado String?
  comissao       Decimal  @default(0) @db.Decimal(10, 2)

  ingressos          Ingresso[]
  participanteCompra ParticipanteCompra?

  @@index([usuarioId])
  @@index([eventoId])
  @@index([promotorId])
}

model Grupo {
  id   String @id @default(cuid())
  nome String

  liderId String
  lider   Usuario @relation("LiderGrupo", fields: [liderId], references: [id])

  criadoEm DateTime @default(now())

  membros MembroGrupo[]
  compras CompraGrupo[]
  convite ConviteGrupo?

  @@index([liderId])
}

// Código de convite do grupo (link compartilhável). Fica fora de Grupo para não vazar nas listagens.
model ConviteGrupo {
  codigo   String   @id
  grupoId  String   @unique
  grupo    Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  criadoEm DateTime @default(now())
}

model MembroGrupo {
  id String @id @default(cuid())

  grupoId String
  grupo   Grupo  @relation(fields: [grupoId], references: [id])

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  entrouEm DateTime @default(now())

  @@unique([grupoId, usuarioId])
  @@index([usuarioId])
}

model CompraGrupo {
  id String @id @default(cuid())

  grupoId String
  grupo   Grupo  @relation(fields: [grupoId], references: [id])

  loteId String
  lote   Lote   @relation(fields: [loteId], references: [id])

  iniciadorId String
  iniciador   Usuario @relation("IniciadorCompra", fields: [iniciadorId], references: [id])

  status   StatusCompraGrupo @default(PENDENTE)
  expiraEm DateTime
  // Código de promotor informado ao iniciar; vale para todas as cotas (usa o maior desconto).
  codigoAfiliado String?
  criadoEm DateTime          @default(now())

  participantes ParticipanteCompra[]

  @@index([grupoId])
  @@index([loteId])
}

model ParticipanteCompra {
  id String @id @default(cuid())

  compraGrupoId String
  compraGrupo   CompraGrupo @relation(fields: [compraGrupoId], references: [id])

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  pedidoId String? @unique
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  status StatusParticipante @default(PENDENTE)

  @@unique([compraGrupoId, usuarioId])
  @@index([usuarioId])
}

model Ingresso {
  id       String         @id @default(cuid())
  codigoQr String         @unique
  status   StatusIngresso @default(VALIDO)

  eventoId String
  evento   Evento  @relation(fields: [eventoId], references: [id])
  loteId   String
  lote     Lote    @relation(fields: [loteId], references: [id])
  pedidoId String
  pedido   Pedido  @relation(fields: [pedidoId], references: [id])
  donoId   String
  dono     Usuario @relation("DonoIngresso", fields: [donoId], references: [id])

  emitidoEm DateTime  @default(now())
  usadoEm   DateTime?

  validacoes ValidacaoIngresso[]

  @@index([eventoId])
  @@index([donoId])
}

model ValidacaoIngresso {
  id String @id @default(cuid())

  codigoLido String
  ingressoId String?
  ingresso   Ingresso? @relation(fields: [ingressoId], references: [id])

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id])

  validadoPorId String
  validadoPor   Usuario            @relation("ValidadoPor", fields: [validadoPorId], references: [id])
  resultado     ResultadoValidacao
  criadoEm      DateTime           @default(now())

  @@index([ingressoId])
  @@index([eventoId])
}

// Papel na plataforma. Quem pode o quê dentro de um evento vem do CargoEvento, não daqui: o ADMIN
// cuida do software (moderação, usuários), não dos eventos.
enum Papel {
  CLIENTE
  ADMIN
}

// Cargos da equipe de um evento, definidos pelo gerente (quem publicou).
enum CargoEvento {
  PROMOTOR
  VALIDADOR
}

enum StatusEvento {
  RASCUNHO
  PUBLICADO
  CANCELADO
  ENCERRADO
}

enum StatusPedido {
  PENDENTE
  PAGO
  CANCELADO
}

enum StatusCompraGrupo {
  PENDENTE
  CONFIRMADA
  EXPIRADA
}

enum StatusParticipante {
  PENDENTE
  PAGO
  REEMBOLSADO
}

enum StatusIngresso {
  VALIDO
  USADO
  CANCELADO
}

enum ResultadoValidacao {
  VALIDO
  JA_UTILIZADO
  INVALIDO
}

// Nota de 1 a 5 de quem foi ao evento (tinha ingresso USADO). A nota do organizador é a média dos eventos dele.
model AvaliacaoEvento {
  id String @id @default(cuid())

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id])

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())

  @@unique([eventoId, usuarioId])
  @@index([eventoId])
}

model EventoMembro {
  id        String      @id @default(cuid())
  eventoId  String
  evento    Evento      @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cargo     CargoEvento
  // Código de afiliado do PROMOTOR (vai no link e é digitado no checkout).
  codigoAfiliado String?    @unique
  criadoEm  DateTime    @default(now())

  // Um cargo por pessoa em cada evento.
  @@unique([eventoId, usuarioId])
  @@index([usuarioId])
}

// Atração do evento: nome livre, foto opcional e, se a atração tiver conta no Groov, a conta marcada.
model Atracao {
  id        String   @id @default(cuid())
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nome      String
  fotoUrl   String?
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())

  @@index([eventoId])
  @@index([usuarioId])
}

// Interações do feed: curtir e salvar um evento, seguir um organizador.
model CurtidaEvento {
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@id([eventoId, usuarioId])
  @@index([usuarioId])
}

model EventoSalvo {
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@id([eventoId, usuarioId])
  @@index([usuarioId])
}

model Seguidor {
  seguidorId String
  seguidor   Usuario  @relation("QuemSegue", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguidoId  String
  seguido    Usuario  @relation("QuemEhSeguido", fields: [seguidoId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())

  @@id([seguidorId, seguidoId])
  @@index([seguidoId])
}

enum MetodoPagamento {
  PIX
  CARTAO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  EXPIRADO
}

// Uma cobrança do checkout. `itens` guarda o que será emitido quando o provedor aprovar (pedidos
// individuais e cotas de compras em grupo); só então os ingressos nascem.
model Pagamento {
  id        String          @id @default(cuid())
  usuarioId String
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])
  metodo    MetodoPagamento
  status    StatusPagamento @default(PENDENTE)
  // SIMULADO (sem credenciais) ou MERCADOPAGO.
  provedor  String
  valor     Decimal         @db.Decimal(10, 2)
  itens     Json

  externoId       String?
  pixCopiaECola   String?
  pixQrCodeBase64 String?
  checkoutUrl     String?

  // Ids dos pedidos e das compras em grupo gerados na aprovação; erroEmissao guarda o motivo se
  // algo não pôde ser emitido (o dinheiro entrou, então precisa de atenção manual/estorno).
  resultado   Json?
  erroEmissao String?

  expiraEm   DateTime
  criadoEm   DateTime  @default(now())
  aprovadoEm DateTime?

  @@index([usuarioId])
  @@index([status, expiraEm])
}

